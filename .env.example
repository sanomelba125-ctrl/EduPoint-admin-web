# ===================================================================
# 校园活动积分平台 (EduPoint) - 管理端后台环境变量配置模板 (.env.example)
#
# 使用方式:
# 1. 复制本文件为 .env.local 或 .env:
#    cp .env.example .env.local
# 2. 填写您在高德开放平台申请的 Web 端 (JS API) Key 与安全密钥
# ===================================================================

# 高德地图开放平台 JS API Key (Web端)
VITE_AMAP_KEY=your_amap_web_key_here

# 高德地图开放平台 安全密钥 (Security JS Code)
VITE_AMAP_SECURITY_JS_CODE=your_amap_security_js_code_here
