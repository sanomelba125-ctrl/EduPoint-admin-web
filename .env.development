# ===================================================================
# 学生活动打卡与积分管理系统 - 管理端本地开发环境变量
# 后端服务端口: 8080 (context-path: /api)
# ===================================================================

# 默认使用本地反向代理路径，由 vite.config.ts 代理到 http://localhost:8080
# 若需绕过本地代理直连后端服务，可改为: http://localhost:8080/api
VITE_API_BASE_URL=/api

# 本地后端运行端口
VITE_BACKEND_PORT=8080

# 电子荣誉证书台账离线 Mock 兜底开关 (生产与真实联调严格设为 false；仅在无后端纯前端离线展示时设为 true)
VITE_ENABLE_CERT_MOCK=false

# 证书防伪公开验真移动端访问基地址
VITE_VERIFY_BASE_URL=http://localhost:5173/#/pages/certificate/verify
